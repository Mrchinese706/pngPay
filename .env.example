# Copy this file to .env and fill in your real Supabase values.
# Never commit .env to version control.
# Get these from: https://supabase.com → your project → Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here
